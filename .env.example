# Dirección Medellín confirmada
VITE_CONTACT_ADDRESS=Calle 50 #77B-47, Medellín
VITE_GOOGLE_MAPS_URL=https://www.google.com/maps/search/?api=1&query=Calle+50+%2377B-47%2C+Medell%C3%ADn%2C+Colombia
