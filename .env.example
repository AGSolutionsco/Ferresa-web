# Ferresa — variables de entorno (AG Solutions)
# Copia este archivo a .env y completa los valores reales.
# Nunca subas .env al repositorio.

# WhatsApp (solo dígitos, con código de país Colombia 57)
VITE_WHATSAPP_NUMBER=573152121687

# Instagram
VITE_INSTAGRAM_URL=https://www.instagram.com/ferresa.co/

# Sitio (SEO / Open Graph en fases posteriores)
VITE_SITE_URL=https://ferresa.co

# Correo (NO DISPONIBLE — no inventar)
